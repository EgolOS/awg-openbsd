#!/usr/local/bin/bash
# SPDX-License-Identifier: GPL-2.0
# awg-quick for OpenBSD — uses ifconfig(8) for all configuration.
# No external 'awg' tool required.
#
# Based on wg-quick/openbsd.bash from amneziawg-tools.

set +x
set -e -o pipefail
shopt -s extglob
export LC_ALL=C

exec 3>&2
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PROGRAM="${0##*/}"
ARGS=( "$@" )

INTERFACE=""
REAL_INTERFACE=""
CONFIG_FILE=""

# [Interface] fields
PRIVATE_KEY=""
LISTEN_PORT=""
ADDRESSES=( )
ADDRESS_FAMILIES=( )
MTU=""
DNS=( )
DNS_SEARCH=( )
TABLE=""
PRE_UP=( )
POST_UP=( )
PRE_DOWN=( )
POST_DOWN=( )

# AWG obfuscation fields
VERSION=""
JC="" JMIN="" JMAX="" S1="" S2="" H1="" H2="" H3="" H4=""
# AWG 3.1 fields
S3="" S4="" HPK="" CPA="" RANDOM_TRAILERS="" DISABLE_COOKIES=""
REKEY_AFTER_TIME="" REKEY_TIMEOUT="" REJECT_AFTER_TIME=""
KEEPALIVE_TIMEOUT="" MAX_HANDSHAKE_ATTEMPTS=""
ISPECS=( "" "" "" "" "" )
AWG31_KEYS=( )   # 3.1-only keys found in the config, for Version checks

# [Peer] data — parallel arrays indexed by peer number
PEER_COUNT=0
PEER_PUBKEYS=( )
PEER_PSKS=( )
PEER_ENDPOINTS=( )
PEER_ENDPOINT_IPS=( )  # resolved IPs read from kernel after set_config
PEER_AIPS=( )    # space-separated per peer
PEER_PKAS=( )

# Routing state
FIRSTADDR4=""
FIRSTADDR6=""
ENDPOINTS=( )
GATEWAY4=""
GATEWAY6=""
ENDPOINT_FAMILY="inet"   # family the Address selects; the endpoint resolves in it

cmd() {
	# Redact even callers of the manual argv interface. Automated secret-key
	# loading below uses stdin; stderr ends up in logs, cron mail
	# and rc.local output.
	local shown=( ) a redact=0
	for a in "$@"; do
		if (( redact )); then
			shown+=( "<redacted>" ); redact=0; continue
		fi
		shown+=( "$a" )
		case "$a" in
		awgkey|awgpsk|awghpk|-awgkey|-awgpsk|-awghpk) redact=1 ;;
		esac
	done
	echo "[#] ${shown[*]}" >&3
	"$@"
}

die() {
	echo "$PROGRAM: $*" >&2
	exit 1
}

# Every numeric config field is validated here, once, before it reaches
# ifconfig or a shell arithmetic context. `(( ))` and `[[ -lt ]]` evaluate
# their operands as arithmetic expressions, so an unvalidated config value
# is code execution, not just a bad value.
need_uint() {	# need_uint <Field> <value> [max]
	local field=$1 v=$2 max=${3:-4294967295}
	[[ $v =~ ^[0-9]+$ ]] || die "$field must be a decimal number, got \`$v'"
	[[ ${#v} -le 10 ]] || die "$field is out of range: \`$v'"
	(( 10#$v <= max )) || die "$field must be <= $max, got \`$v'"
}

need_range() {	# need_range <Field> <value> [max] — value or low-high
	local field=$1 v=$2 max=${3:-65535}
	if [[ $v == *-* ]]; then
		need_uint "$field low" "${v%%-*}" "$max"
		need_uint "$field high" "${v#*-}" "$max"
		(( 10#${v%%-*} <= 10#${v#*-} )) || die "$field range must be low-high, got \`$v'"
	else
		need_uint "$field" "$v" "$max"
	fi
}

# Hooks are root programs. Mode 0600 alone does not make a user-owned file
# trusted, and a writable ancestor permits replacing an otherwise safe file.
trusted_config_path() {
	local path=$1 owner mode
	[[ -f $path ]] || die "config must be a regular file"
	while :; do
		owner=$(stat -f %u "$path") || die "cannot stat config path"
		mode=$(stat -f %Lp "$path") || die "cannot stat config path"
		[[ $owner == 0 && $mode =~ ^[0-7]{3,4}$ ]] || die "config path must be root-owned: $path"
		(( (8#$mode & 0022) == 0 )) || die "config path must not be group/other-writable: $path"
		[[ $path == / ]] && break
		path=${path%/*}; [[ -n $path ]] || path=/
	done
}

parse_options() {
	# Save shell options: list splitting must never expand globs from cwd.
	local -
	set -f
	local line key value stripped v
	local in_interface=0 in_peer=0
	local cur_pubkey="" cur_psk="" cur_endpoint="" cur_aips="" cur_pka=""

	CONFIG_FILE="$1"
	[[ $CONFIG_FILE =~ ^[a-zA-Z0-9_=+.-]{1,15}$ ]] && \
		CONFIG_FILE="/etc/amnezia/amneziawg/$CONFIG_FILE.conf"
	[[ -e $CONFIG_FILE ]] || die "\`$CONFIG_FILE' does not exist"
	[[ $CONFIG_FILE =~ (^|/)([a-zA-Z0-9_=+.-]{1,15})\.conf$ ]] || \
		die "The config file must be a valid interface name, followed by .conf"
	INTERFACE="${BASH_REMATCH[2]}"
	CONFIG_FILE="$(readlink -f "$CONFIG_FILE")"
	trusted_config_path "$CONFIG_FILE"

	# R8/R4-08: a config with NUL bytes or a truncated last line is
	# refused before any field is applied — the bytes behind a NUL and
	# behind the cut must not reach the interface.
	[[ $(tr -dc '\0' < "$CONFIG_FILE" | wc -c) -eq 0 ]] \
		|| die "\`$CONFIG_FILE' contains NUL bytes"
	[[ $(tail -c 1 "$CONFIG_FILE" | wc -l) -eq 1 ]] \
		|| die "\`$CONFIG_FILE' has a truncated last line"

	# The config holds the long-term private key and can carry PreUp/PostUp
	# commands that run as root. Refuse one other users can read.
	local mode
	mode=$(stat -f %Lp "$CONFIG_FILE" 2>/dev/null) || die "cannot stat $CONFIG_FILE"
	case "$mode" in
	600|400) ;;
	*) die "$CONFIG_FILE is mode $mode — it holds the private key; chmod 600 it" ;;
	esac
	mode=$(stat -f %Lp "$(dirname "$CONFIG_FILE")" 2>/dev/null)
	[[ $mode == 700 ]] || echo "[!] WARNING: $(dirname "$CONFIG_FILE") is mode $mode, expected 700" >&2

	flush_peer() {
		[[ -n $cur_pubkey ]] || return 0
		PEER_PUBKEYS[$PEER_COUNT]="$cur_pubkey"
		PEER_PSKS[$PEER_COUNT]="$cur_psk"
		PEER_ENDPOINTS[$PEER_COUNT]="$cur_endpoint"
		PEER_AIPS[$PEER_COUNT]="$cur_aips"
		PEER_PKAS[$PEER_COUNT]="$cur_pka"
		(( PEER_COUNT++ )) || true
		cur_pubkey="" cur_psk="" cur_endpoint="" cur_aips="" cur_pka=""
	}

	shopt -s nocasematch
	while IFS= read -r line || [[ -n $line ]]; do
		stripped="${line%%\#*}"
		key="${stripped%%=*}"; key="${key##*([[:space:]])}"; key="${key%%*([[:space:]])}"
		value="${stripped#*=}"; value="${value##*([[:space:]])}"; value="${value%%*([[:space:]])}"

		if [[ $key == "[Interface]" ]]; then
			flush_peer; in_interface=1; in_peer=0; continue
		fi
		if [[ $key == "[Peer]" ]]; then
			flush_peer; in_interface=0; in_peer=1; continue
		fi

		if [[ $in_interface -eq 1 ]]; then
			case "$key" in
			PrivateKey)            PRIVATE_KEY="$value" ;;
			ListenPort)            LISTEN_PORT="$value" ;;
			Address)               ADDRESSES+=( ${value//,/ } ) ;;
			MTU)                   MTU="$value" ;;
			DNS) for v in ${value//,/ }; do
				validate_dns "$v"
			done ;;
			Table)                 TABLE="$value" ;;
			PreUp)                 PRE_UP+=( "$value" ) ;;
			PreDown)               PRE_DOWN+=( "$value" ) ;;
			PostUp)                POST_UP+=( "$value" ) ;;
			PostDown)              POST_DOWN+=( "$value" ) ;;
			Version)               VERSION="$value" ;;
			Jc)                    JC="$value" ;;
			Jmin)                  JMIN="$value" ;;
			Jmax)                  JMAX="$value" ;;
			S1)                    S1="$value" ;;
			S2)                    S2="$value" ;;
			H1)                    H1="$value" ;;
			H2)                    H2="$value" ;;
			H3)                    H3="$value" ;;
			H4)                    H4="$value" ;;
			S3)                    S3="$value" ;;
			S4)                    S4="$value" ;;
			I[1-5])                ISPECS[${key:1}-1]="$value" ;;
			HeaderProtectionKey)   HPK="$value" ;;
			ContentPaddingAddition) CPA="$value" ;;
			RekeyAfterTime)        REKEY_AFTER_TIME="$value" ;;
			RekeyTimeout)          REKEY_TIMEOUT="$value" ;;
			RejectAfterTime)       REJECT_AFTER_TIME="$value" ;;
			KeepaliveTimeout)      KEEPALIVE_TIMEOUT="$value" ;;
			MaxHandshakeAttempts)  MAX_HANDSHAKE_ATTEMPTS="$value" ;;
			RandomTrailers)        RANDOM_TRAILERS="$value" ;;
			DisableCookies)        DISABLE_COOKIES="$value" ;;
			esac
			case "$key" in
			S3|S4|I[1-5]|HeaderProtectionKey|ContentPaddingAddition|\
			RekeyAfterTime|RekeyTimeout|RejectAfterTime|KeepaliveTimeout|\
			MaxHandshakeAttempts|RandomTrailers|DisableCookies)
				[[ -n $value ]] && AWG31_KEYS+=( "$key" ) ;;
			H[1-4])
				[[ $value == *-* ]] && AWG31_KEYS+=( "$key range" ) ;;
			esac
		elif [[ $in_peer -eq 1 ]]; then
			case "$key" in
			PublicKey)             cur_pubkey="$value" ;;
			PresharedKey)          cur_psk="$value" ;;
			Endpoint)              cur_endpoint="$value" ;;
			AllowedIPs)            cur_aips+="${cur_aips:+ }${value//,/ }" ;;
			PersistentKeepalive)   cur_pka="$value"
				[[ $value == *-* ]] && AWG31_KEYS+=( "PersistentKeepalive range" ) ;;
			esac
		fi
	done < "$CONFIG_FILE"
	flush_peer
	shopt -u nocasematch

	[[ -n $PRIVATE_KEY ]] || die "PrivateKey not set in $CONFIG_FILE"

	# Numeric fields, validated once (see need_uint): they are interpolated
	# into ifconfig arguments and shell arithmetic, so a non-numeric value
	# is a code-execution vector, not a config error.
	[[ -z $LISTEN_PORT ]] || need_uint ListenPort "$LISTEN_PORT" 65535
	# MTU: the wire MTU of an awg(4) interface is 576..9000 (R8).
	if [[ -n $MTU ]]; then
		need_uint MTU "$MTU" 9000
		(( 10#$MTU >= 576 )) || die "MTU must be 576..9000, got \`$MTU'"
	fi
	[[ -z $JC ]] || need_uint Jc "$JC" 64
	[[ -z $JMIN ]] || need_uint Jmin "$JMIN" 1500
	[[ -z $JMAX ]] || need_uint Jmax "$JMAX" 1500
	[[ -z $S1 ]] || need_uint S1 "$S1" 1280
	[[ -z $S2 ]] || need_uint S2 "$S2" 1280
	[[ -z $S3 ]] || need_uint S3 "$S3" 1280
	[[ -z $S4 ]] || need_uint S4 "$S4" 1280
	[[ -z $H1 ]] || need_range H1 "$H1" 4294967295
	[[ -z $H2 ]] || need_range H2 "$H2" 4294967295
	[[ -z $H3 ]] || need_range H3 "$H3" 4294967295
	[[ -z $H4 ]] || need_range H4 "$H4" 4294967295
	[[ -z $CPA ]] || need_range ContentPaddingAddition "$CPA" 65535
	[[ -z $REKEY_AFTER_TIME ]] || need_range RekeyAfterTime "$REKEY_AFTER_TIME" 65535
	[[ -z $REKEY_TIMEOUT ]] || need_range RekeyTimeout "$REKEY_TIMEOUT" 65535
	[[ -z $REJECT_AFTER_TIME ]] || need_range RejectAfterTime "$REJECT_AFTER_TIME" 65535
	[[ -z $KEEPALIVE_TIMEOUT ]] || need_range KeepaliveTimeout "$KEEPALIVE_TIMEOUT" 65535
	[[ -z $MAX_HANDSHAKE_ATTEMPTS ]] || need_range MaxHandshakeAttempts "$MAX_HANDSHAKE_ATTEMPTS" 65535
	[[ -z $cur_pka ]] || need_range PersistentKeepalive "$cur_pka" 65535
	local p
	for (( p=0; p<PEER_COUNT; p++ )); do
		[[ -z ${PEER_PKAS[$p]} ]] || need_range PersistentKeepalive "${PEER_PKAS[$p]}" 65535
	done

	# Version: legacy (AmneziaWG < 3.1) or 3.1. Without it, a config
	# using any 3.1-only parameter selects 3.1.
	VERSION="${VERSION,,}"
	case "$VERSION" in
	"")     [[ ${#AWG31_KEYS[@]} -eq 0 ]] && VERSION=legacy || VERSION=3.1 ;;
	legacy) [[ ${#AWG31_KEYS[@]} -eq 0 ]] || \
			die "Version = legacy, but AmneziaWG 3.1 parameters are set: ${AWG31_KEYS[*]}" ;;
	3.1)    ;;
	*)      die "Version must be legacy or 3.1, got \`$VERSION'" ;;
	esac

	# The kernel takes the header protection nonce from the S1-S4 prefixes.
	# The values are digits-only by now (need_uint above); keep them in
	# locals so the arithmetic context never re-parses config text.
	local s1=${S1:-0} s2=${S2:-0} s3=${S3:-0} s4=${S4:-0}
	if [[ -n $HPK ]] && (( s1 < 12 || s2 < 12 || s3 < 12 || s4 < 12 )); then
		die "HeaderProtectionKey requires S1, S2, S3 and S4 of at least 12"
	fi

	[[ -z $RANDOM_TRAILERS ]] || RANDOM_TRAILERS="$(parse_bool RandomTrailers "$RANDOM_TRAILERS")" || exit 1
	[[ -z $DISABLE_COOKIES ]] || DISABLE_COOKIES="$(parse_bool DisableCookies "$DISABLE_COOKIES")" || exit 1
}

# RandomTrailers/DisableCookies: on/off or a number, as in amneziawg-tools
parse_bool() {
	local name="$1" value="${2,,}"
	if [[ $value == on ]]; then
		echo 1
	elif [[ $value == off ]]; then
		echo 0
	elif [[ $value =~ ^[0-9]+$ ]]; then
		(( 10#$value != 0 )) && echo 1 || echo 0
	else
		die "$name: boolean value is neither on/off nor 0/1: \`$2'"
	fi
}

# validate_dns <v>: an IPv4 (octet ranges) or IPv6 entry is a resolver
# address and is validated as one; anything else is a search domain (R8).
validate_dns() {
	local v="$1"
	if [[ $v =~ ^[0-9.]+$ ]]; then
		is_ipv4 "$v" || die "DNS '$v' is not a valid IPv4 address"
		DNS+=( "$v" )
	elif [[ $v == *:* ]]; then
		is_ipv6 "${v%%\%*}" || die "DNS '$v' is not a valid IPv6 address"
		DNS+=( "$v" )
	else
		DNS_SEARCH+=( "$v" )
	fi
}

# Find existing awg/wg interface that matches INTERFACE name/description
get_real_interface() {
	local iface line
	# Config name matches interface name directly (awg0, wg0, etc.)
	if ifconfig "$INTERFACE" >/dev/null 2>&1; then
		REAL_INTERFACE="$INTERFACE"
		return 0
	fi
	# Arbitrary name: search for description "wg-quick: INTERFACE"
	while IFS= read -r line; do
		if [[ $line =~ ^([a-z]+[0-9]+):\ .+ ]]; then
			iface="${BASH_REMATCH[1]}"
			continue
		fi
		if [[ ($iface == wg* || $iface == awg*) && \
		      $line =~ $'\t'description:\ wg-quick:\ (.+) && \
		      ${BASH_REMATCH[1]} == "$INTERFACE" ]]; then
			REAL_INTERFACE="$iface"
			return 0
		fi
	done < <(ifconfig)
	return 1
}

add_if() {
	local ret index
	# Config name is already awgN — create that exact interface
	if [[ $INTERFACE =~ ^awg[0-9]+$ ]]; then
		if ret="$(cmd ifconfig "$INTERFACE" create 2>&1)"; then
			REAL_INTERFACE="$INTERFACE"
			return 0
		fi
		[[ $ret == *"File exists"* ]] && { REAL_INTERFACE="$INTERFACE"; return 0; }
		echo "$ret" >&3; return 1
	fi
	# Arbitrary name: pick next free awgN
	while true; do
		local existing
		existing="$(ifconfig -a 2>/dev/null | grep -Eo '^awg[0-9]+' | sort -t g -k2 -n || true)"
		for (( index=0; ; index++ )); do
			grep -qx "awg$index" <<< "$existing" || break
		done
		if ret="$(cmd ifconfig awg$index create 2>&1)"; then
			cmd ifconfig awg$index description "wg-quick: $INTERFACE"
			REAL_INTERFACE="awg$index"
			return 0
		fi
		[[ $ret == *"File exists"* ]] && continue
		echo "$ret" >&3; return 1
	done
}

del_if() {
	unset_dns
	[[ -n $REAL_INTERFACE ]] && cmd ifconfig "$REAL_INTERFACE" destroy
}

up_if() {
	cmd ifconfig "$REAL_INTERFACE" up
}

# Configure AWG interface via ifconfig — no 'awg' tool needed.
#
# R4-08: parsing, resolution and serialisation happen in prepare_config,
# *before* any mutation, so a bad PrivateKey, peer endpoint, allowed-IP or
# address fails before the interface is created. build_config_args serialises
# the argument vector (and the stdin key list); apply_config performs the
# single ifconfig mutation with it.
# validate_endpoint <ep>: host:port with the port in 1..65535; the host is a
# bracketed IPv6, a plain IPv4 (octets range-checked) or an RFC 1123
# hostname. R8/R4-08: resolved here, serialised into CONFIG_ARGS, so the
# single ifconfig mutation receives a complete, valid endpoint.
# R9/R4-08b: the resolution happens here too — a hostname is turned into a
# numeric address of ENDPOINT_FAMILY before the interface is created, so a
# name that does not resolve exits with nothing created.
validate_endpoint() {
	local ep="$1" host port addr
	if [[ $ep =~ ^\[(.+)\]:([0-9]+)$ ]]; then
		host="${BASH_REMATCH[1]}"; port="${BASH_REMATCH[2]}"
		is_ipv6 "$host" \
			|| die "Peer endpoint '$ep' is not a valid [IPv6]:port"
	elif [[ $ep =~ ^([^:]+):([0-9]+)$ ]]; then
		host="${BASH_REMATCH[1]}"; port="${BASH_REMATCH[2]}"
		is_ipv4 "$host" || is_hostname "$host" \
			|| die "Peer endpoint '$ep' is not a valid host:port"
	else
		die "Peer endpoint '$ep' is not host:port"
	fi
	(( 10#$port >= 1 && 10#$port <= 65535 )) \
		|| die "Peer endpoint '$ep' has an invalid port (1..65535)"
	addr="$(resolve_endpoint_host "$host")" \
		|| die "Peer endpoint '$ep' does not resolve to an $ENDPOINT_FAMILY address"
	CONFIG_ARGS+=( awgendpoint "$addr" "$port" )
}

build_config_args() {
	local -
	set -f
	CONFIG_ARGS=() CONFIG_KEYS=( "$PRIVATE_KEY" )

	[[ -n $PRIVATE_KEY ]] || die "no PrivateKey"
	CONFIG_ARGS+=( awgversion "$VERSION" )
	# All secret keys are fed on stdin in argv order: the argument vector of a
	# root process is readable with ps(1) and lands in core dumps.
	CONFIG_ARGS+=( awgkey - )
	[[ -n $LISTEN_PORT ]] && CONFIG_ARGS+=( awgport "$LISTEN_PORT" )

	# AWG obfuscation params
	if [[ -n $JC || -n $JMIN || -n $JMAX ]]; then
		CONFIG_ARGS+=( awgjc  "${JC:-0}"  awgjmin "${JMIN:-0}" awgjmax "${JMAX:-0}" )
	fi
	if [[ -n $S1 || -n $S2 ]]; then
		CONFIG_ARGS+=( awgs1 "${S1:-0}" awgs2 "${S2:-0}" )
	fi
	if [[ -n $H1 || -n $H2 || -n $H3 || -n $H4 ]]; then
		CONFIG_ARGS+=( awgh1 "${H1:-1}" awgh2 "${H2:-2}" awgh3 "${H3:-3}" awgh4 "${H4:-4}" )
	fi

	# AWG 3.1 params
	[[ -n $S3 ]] && CONFIG_ARGS+=( awgs3 "$S3" )
	[[ -n $S4 ]] && CONFIG_ARGS+=( awgs4 "$S4" )
	local n
	for (( n=0; n<5; n++ )); do
		[[ -n ${ISPECS[$n]} ]] && CONFIG_ARGS+=( "awgi$(( n + 1 ))" "${ISPECS[$n]}" )
	done
	if [[ -n $HPK ]]; then CONFIG_ARGS+=( awghpk - ); CONFIG_KEYS+=( "$HPK" ); fi
	[[ -n $CPA ]] && CONFIG_ARGS+=( awgcpa "$CPA" )
	[[ -n $REKEY_AFTER_TIME ]] && CONFIG_ARGS+=( awgrekeyaftertime "$REKEY_AFTER_TIME" )
	[[ -n $REKEY_TIMEOUT ]] && CONFIG_ARGS+=( awgrekeytimeout "$REKEY_TIMEOUT" )
	[[ -n $REJECT_AFTER_TIME ]] && CONFIG_ARGS+=( awgrejectaftertime "$REJECT_AFTER_TIME" )
	[[ -n $KEEPALIVE_TIMEOUT ]] && CONFIG_ARGS+=( awgkeepalivetimeout "$KEEPALIVE_TIMEOUT" )
	[[ -n $MAX_HANDSHAKE_ATTEMPTS ]] && CONFIG_ARGS+=( awgmaxhandshakeattempts "$MAX_HANDSHAKE_ATTEMPTS" )
	case "$RANDOM_TRAILERS" in
	1) CONFIG_ARGS+=( awgrandomtrailers ) ;;
	0) CONFIG_ARGS+=( -awgrandomtrailers ) ;;
	esac
	case "$DISABLE_COOKIES" in
	1) CONFIG_ARGS+=( awgdisablecookies ) ;;
	0) CONFIG_ARGS+=( -awgdisablecookies ) ;;
	esac

	# Peers: the endpoint must be host:port (bracketed for IPv6) and every
	# allowed-IP must be an address with a 0..128 prefix, validated here so a
	# malformed peer fails before the interface is touched.
	local i aip
	for (( i=0; i<PEER_COUNT; i++ )); do
		CONFIG_ARGS+=( awgpeer "${PEER_PUBKEYS[$i]}" )
		if [[ -n ${PEER_PSKS[$i]} ]]; then
			CONFIG_ARGS+=( awgpsk - ); CONFIG_KEYS+=( "${PEER_PSKS[$i]}" )
		fi
		[[ -n ${PEER_PKAS[$i]} ]] && CONFIG_ARGS+=( awgpka "${PEER_PKAS[$i]}" )
		local ep="${PEER_ENDPOINTS[$i]}"
		if [[ -n $ep ]]; then
			validate_endpoint "$ep"
		fi
		for aip in ${PEER_AIPS[$i]}; do
			validate_cidr "$aip" "AllowedIPs"
			CONFIG_ARGS+=( awgaip "$aip" )
		done
	done
}

apply_config() {
	printf '%s\n' "${CONFIG_KEYS[@]}" | cmd ifconfig "$REAL_INTERFACE" "${CONFIG_ARGS[@]}"
}

# prepare_config parses, resolves and serialises everything that does not
# mutate the interface: private key, address families/prefixes, the peer
# endpoint and allowed-IP argument vector, and the MTU from the endpoint
# route. cmd_up calls this once before add_if (R4-08).
prepare_config() {
	[[ -n $PRIVATE_KEY ]] || die "no PrivateKey"
	local i
	ADDRESS_FAMILIES=()
	for (( i=0; i<${#ADDRESSES[@]}; i++ )); do
		validate_cidr "${ADDRESSES[$i]}" "Address"
		[[ "${ADDRESSES[$i]}" == *:* ]] && ADDRESS_FAMILIES+=( inet6 ) \
			|| ADDRESS_FAMILIES+=( inet )
	done
	# R9/R4-08b: the underlay the tunnel traffic leaves through is the
	# Address family, so the peer endpoint resolves in that family (inet
	# when the config carries no Address). build_config_args resolves the
	# endpoint with it, before add_if creates the interface.
	[[ ${#ADDRESS_FAMILIES[@]} -gt 0 ]] && ENDPOINT_FAMILY="${ADDRESS_FAMILIES[0]}"
	build_config_args
	resolve_mtu
}

# R8/R4-08: the address grammar is resolved here (octet ranges, IPv6 form,
# per-family prefix limits) so every field is fully parsed before the
# interface is touched, not half-parsed by shape and finished by ifconfig.
is_ipv4() {	# four octets, each 0..255
	local o
	[[ $1 =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
	for o in "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" \
		 "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"; do
		(( 10#$o <= 255 )) || return 1
	done
	return 0
}

is_ipv6() {	# full and compressed forms, 0..ffff per group
	[[ $1 =~ ^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$ ]]
}

is_hostname() {	# RFC 1123 labels, for a resolvable Endpoint host
	[[ $1 =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*\.?$ ]]
}

# resolve_endpoint_host <host>: the numeric address for an Endpoint host.
# A numeric host is echoed as it is (no resolver call); a hostname goes to
# getent(1) once per run — no cache — and the first answer of ENDPOINT_FAMILY
# is echoed. Exit non-zero when the name yields no address of that family.
resolve_endpoint_host() {
	local host="$1" out addr
	if is_ipv4 "$host" || is_ipv6 "$host"; then
		printf '%s\n' "$host"
		return 0
	fi
	out="$(getent hosts "$host" 2>/dev/null)" || return 1
	for addr in $out; do
		case "$addr" in *[!0-9a-fA-F:.]*) continue ;; esac
		if [[ $ENDPOINT_FAMILY == inet6 ]]; then
			is_ipv6 "$addr" || continue
		else
			is_ipv4 "$addr" || continue
		fi
		printf '%s\n' "${addr%%\%*}"
		return 0
	done
	return 1
}

# validate_cidr <cidr> <label>: address with an optional prefix, 0..32 for
# IPv4 and 0..128 for IPv6 (R8: the prefix limit follows the family).
validate_cidr() {
	local cidr="$1" label="$2" addr="${1}" prefix=""
	[[ "$cidr" == "*" ]] && return 0   # wildcard: every address
	case "$cidr" in
	*/*) addr="${cidr%/*}"; prefix="${cidr#*/}" ;;
	esac
	if [[ "$addr" == *:* ]]; then
		is_ipv6 "${addr%%\%*}" \
			|| die "$label '$cidr' is not a valid IPv6 address"
		[[ -z "$prefix" || ( "$prefix" =~ ^[0-9]+$ && 10#$prefix -le 128 ) ]] \
			|| die "$label '$cidr' has an invalid prefix (IPv6: 0..128)"
	else
		is_ipv4 "$addr" \
			|| die "$label '$cidr' is not a valid IPv4 address"
		[[ -z "$prefix" || ( "$prefix" =~ ^[0-9]+$ && 10#$prefix -le 32 ) ]] \
			|| die "$label '$cidr' has an invalid prefix (IPv4: 0..32)"
	fi
}

# add_addresses installs the pre-serialised addresses (family decided at parse
# time), so no address is parsed after the interface exists.
add_addresses() {
	local i addr family
	for (( i=0; i<${#ADDRESSES[@]}; i++ )); do
		addr="${ADDRESSES[$i]}"
		family="${ADDRESS_FAMILIES[$i]}"
		if [[ $family == inet6 ]]; then
			[[ -n $FIRSTADDR6 ]] || FIRSTADDR6="${addr%/*}"
		else
			[[ -n $FIRSTADDR4 ]] || FIRSTADDR4="${addr%/*}"
		fi
		cmd ifconfig "$REAL_INTERFACE" "$family" "$addr" alias
	done
}

# resolve_mtu computes MTU_VALUE from the endpoint routes (read-only);
# apply_mtu writes it to the interface.
resolve_mtu() {
	MTU_VALUE="$MTU"
	[[ -n $MTU ]] && return
	local mtu=0 endpoint output family host iface ifmtu
	local i
	for (( i=0; i<PEER_COUNT; i++ )); do
		endpoint="${PEER_ENDPOINTS[$i]}"
		[[ -n $endpoint ]] || continue
		if [[ $endpoint =~ ^\[(.+)\\]:[0-9]+$ ]]; then
			host="${BASH_REMATCH[1]}"; family=inet6
		elif [[ $endpoint =~ ^(.+):[0-9]+$ ]]; then
			host="${BASH_REMATCH[1]}"
			[[ $host == *:* ]] && family=inet6 || family=inet
		else
			continue
		fi
		output="$(route -n get "-$family" "$host" 2>/dev/null || true)"
		[[ $output =~ interface:\ ([^ $'\n']+) ]] && iface="${BASH_REMATCH[1]}" || continue
		[[ $(ifconfig "$iface" 2>/dev/null) =~ mtu\ ([0-9]+) ]] && ifmtu="${BASH_REMATCH[1]}" || continue
		[[ $ifmtu -gt $mtu ]] && mtu=$ifmtu
	done
	if [[ $mtu -eq 0 ]]; then
		output="$(route -n get default 2>/dev/null || true)"
		[[ $output =~ interface:\ ([^ $'\n']+) ]] && iface="${BASH_REMATCH[1]}" || true
		[[ -n $iface && $(ifconfig "$iface" 2>/dev/null) =~ mtu\ ([0-9]+) ]] && mtu="${BASH_REMATCH[1]}"
	fi
	[[ $mtu -gt 0 ]] || mtu=1500
	MTU_VALUE=$(( mtu - 80 ))
}

apply_mtu() {
	cmd ifconfig "$REAL_INTERFACE" mtu "$MTU_VALUE"
}

collect_gateways() {
	GATEWAY4=""
	while read -r destination gateway _; do
		[[ $destination == default ]] || continue
		GATEWAY4="$gateway"; break
	done < <(netstat -nr -f inet)

	GATEWAY6=""
	while read -r destination gateway _; do
		[[ $destination == default ]] || continue
		GATEWAY6="$gateway"; break
	done < <(netstat -nr -f inet6)
}

populate_endpoint_ips() {
	# Read resolved endpoint IPs from the kernel (ifconfig already resolved hostnames
	# when set_config ran awgendpoint). Output line: "awgendpoint IP PORT"
	local i=0 line
	while IFS= read -r line; do
		if [[ $line =~ ^[[:space:]]*awgendpoint[[:space:]]+([^[:space:]]+)[[:space:]] ]]; then
			PEER_ENDPOINT_IPS[$i]="${BASH_REMATCH[1]}"
			(( i++ )) || true
		fi
	done < <(ifconfig "$REAL_INTERFACE" 2>/dev/null)
}

collect_endpoints() {
	ENDPOINTS=( )
	local i ip
	for (( i=0; i<PEER_COUNT; i++ )); do
		ip="${PEER_ENDPOINT_IPS[$i]}"
		[[ -n $ip ]] || continue
		ENDPOINTS+=( "$ip" )
	done
}

del_routes() {
	local todelete=( ) destination gateway netif
	[[ -n $REAL_INTERFACE ]] || return 0
	while read -r destination _ _ _ _ netif _; do
		[[ $netif == "$REAL_INTERFACE" ]] && todelete+=( "$destination" )
	done < <(netstat -nr -f inet)
	for destination in "${todelete[@]}"; do
		cmd route -q -n delete -inet "$destination" || true
	done
	todelete=( )
	while read -r destination gateway _ netif; do
		[[ $netif == "$REAL_INTERFACE" || ( $netif == lo* && $gateway == "$REAL_INTERFACE" ) ]] && \
			todelete+=( "$destination" )
	done < <(netstat -nr -f inet6)
	for destination in "${todelete[@]}"; do
		cmd route -q -n delete -inet6 "$destination" || true
	done
	for destination in "${ENDPOINTS[@]}"; do
		if [[ $destination == *:* ]]; then
			cmd route -q -n delete -inet6 "$destination" || true
		else
			cmd route -q -n delete -inet "$destination" || true
		fi
	done
}

add_route() {
	[[ $TABLE != off ]] || return 0
	local family ifaceroute
	if [[ $1 == *:* ]]; then
		family=inet6
		# Provider configs often carry ::/0 without an IPv6 Address. Such a
		# route cannot be installed, and the traffic it was meant to cover
		# leaves through the physical interface instead: fail closed.
		if [[ -z $FIRSTADDR6 ]]; then
			if [[ ${AWG_ALLOW_IPV6_BYPASS:-0} == 1 ]]; then
				echo "[!] WARNING: no IPv6 Address set, skipping route $1" >&2
				return 0
			fi
			die "AllowedIPs has $1 but no IPv6 Address is set: IPv6 traffic would bypass the tunnel. Set an IPv6 Address, drop $1, or export AWG_ALLOW_IPV6_BYPASS=1 to accept the leak"
		fi
		ifaceroute="$FIRSTADDR6"
	else
		family=inet
		[[ -n $FIRSTADDR4 ]] || die "Local IPv4 address must be set to have routes"
		ifaceroute="$FIRSTADDR4"
	fi

	if [[ -n $TABLE && $TABLE != auto ]]; then
		cmd route -q -n -T "$TABLE" add "-$family" "$1" -iface "$ifaceroute"
	elif [[ $1 == */0 ]]; then
		if [[ $1 == *:* ]]; then
			cmd route -q -n add -inet6 ::/1    -iface "$ifaceroute"
			cmd route -q -n add -inet6 8000::/1 -iface "$ifaceroute"
		else
			cmd route -q -n add -inet 0.0.0.0/1   -iface "$ifaceroute"
			cmd route -q -n add -inet 128.0.0.0/1 -iface "$ifaceroute"
		fi
	else
		[[ $(route -n get "-$family" "$1" 2>/dev/null) =~ interface:\ $REAL_INTERFACE$'\n' ]] || \
			cmd route -q -n add "-$family" "$1" -iface "$ifaceroute"
	fi
}

set_endpoint_direct_route() {
	local old_endpoints endpoint old_gateway4 old_gateway6 remove_all_old=0 added=( )
	old_endpoints=( "${ENDPOINTS[@]}" )
	old_gateway4="$GATEWAY4"
	old_gateway6="$GATEWAY6"
	collect_gateways
	collect_endpoints

	[[ $old_gateway4 != "$GATEWAY4" || $old_gateway6 != "$GATEWAY6" ]] && remove_all_old=1

	if [[ $remove_all_old -eq 1 ]]; then
		for endpoint in "${ENDPOINTS[@]}"; do
			[[ " ${old_endpoints[*]} " == *" $endpoint "* ]] || old_endpoints+=( "$endpoint" )
		done
	fi

	for endpoint in "${old_endpoints[@]}"; do
		[[ $remove_all_old -eq 0 && " ${ENDPOINTS[*]} " == *" $endpoint "* ]] && continue
		if [[ $endpoint == *:* ]]; then
			cmd route -q -n delete -inet6 "$endpoint" 2>/dev/null || true
		else
			cmd route -q -n delete -inet "$endpoint" 2>/dev/null || true
		fi
	done

	for endpoint in "${ENDPOINTS[@]}"; do
		if [[ $remove_all_old -eq 0 && " ${old_endpoints[*]} " == *" $endpoint "* ]]; then
			added+=( "$endpoint" ); continue
		fi
		if [[ $endpoint == *:* ]]; then
			if [[ $(route -n get -inet6 "$endpoint" 2>/dev/null) =~ interface:\ $REAL_INTERFACE ]]; then
				if [[ -n $GATEWAY6 ]]; then
					cmd route -q -n add -inet6 "$endpoint" -gateway "$GATEWAY6" || true
				else
					cmd route -q -n add -inet6 "$endpoint" ::1 -blackhole || true
				fi
				added+=( "$endpoint" )
			fi
		else
			if [[ $(route -n get -inet "$endpoint" 2>/dev/null) =~ interface:\ $REAL_INTERFACE ]]; then
				if [[ -n $GATEWAY4 ]]; then
					cmd route -q -n add -inet "$endpoint" -gateway "$GATEWAY4" || true
				else
					cmd route -q -n add -inet "$endpoint" 127.0.0.1 -blackhole || true
				fi
				added+=( "$endpoint" )
			fi
		fi
	done
	ENDPOINTS=( "${added[@]}" )
}

monitor_daemon() {
	echo "[+] Backgrounding route monitor" >&2
	(trap 'del_routes; exit 0' INT TERM EXIT
	exec >/dev/null 2>&1
	exec 19< <(exec route -n monitor)
	local event
	while read -u 19 -r event; do
		[[ $event == RTM_* ]] || continue
		ifconfig "$REAL_INTERFACE" >/dev/null 2>&1 || break
		set_endpoint_direct_route
	done) & disown
}

set_dns() {
	[[ ${#DNS[@]} -gt 0 ]] || return 0
	if pgrep -qx unwind; then
		echo "[!] WARNING: unwind will leak DNS queries" >&2
	elif ! pgrep -qx resolvd; then
		echo "[+] resolvd is not running, DNS will not be configured" >&2
		return 0
	fi
	cmd cp /etc/resolv.conf "/etc/resolv.conf.wg-quick-backup.$INTERFACE"
	[[ ${#DNS_SEARCH[@]} -eq 0 ]] || cmd printf 'search %s\n' "${DNS_SEARCH[*]}" > /etc/resolv.conf
	cmd route nameserver "$REAL_INTERFACE" "${DNS[@]}"
}

unset_dns() {
	[[ -f "/etc/resolv.conf.wg-quick-backup.$INTERFACE" ]] || return 0
	cmd route nameserver "$REAL_INTERFACE"
	cmd mv "/etc/resolv.conf.wg-quick-backup.$INTERFACE" /etc/resolv.conf
}

execute_hooks() {
	local hook
	for hook in "$@"; do
		hook="${hook//%i/$REAL_INTERFACE}"
		hook="${hook//%I/$INTERFACE}"
		echo "[#] $hook" >&2
		(eval "$hook")
	done
}

auto_su() {
	[[ $UID == 0 ]] || exec doas -- "$BASH" -- "$SELF" "${ARGS[@]}"
}

cmd_up() {
	# R4-08: parse, resolve and serialise the whole configuration first
	# (private key, addresses, peer endpoints, allowed-IPs, MTU); only then
	# mutate the interface. An operational failure after creation runs the
	# existing trap (del_if; del_routes), which restores the state.
	prepare_config
	get_real_interface && die "\`$INTERFACE' already exists as \`$REAL_INTERFACE'"
	trap 'del_if; del_routes; exit' INT TERM EXIT
	add_if
	execute_hooks "${PRE_UP[@]}"
	apply_config
	populate_endpoint_ips
	add_addresses
	apply_mtu
	up_if
	set_dns
	local aip all_aips=( ) peer_aips=( )
	for (( i=0; i<PEER_COUNT; i++ )); do
		read -r -a peer_aips <<< "${PEER_AIPS[$i]}"
		all_aips+=( "${peer_aips[@]}" )
	done
	while IFS= read -r aip; do
		[[ -z $aip ]] || add_route "$aip"
	done < <(printf '%s\n' "${all_aips[@]}" | sort -nr -k2 -t/)
	set_endpoint_direct_route
	monitor_daemon
	execute_hooks "${POST_UP[@]}"
	trap - INT TERM EXIT
}

cmd_down() {
	get_real_interface || die "\`$INTERFACE' is not a WireGuard/AWG interface"
	execute_hooks "${PRE_DOWN[@]}"
	collect_endpoints
	del_if
	unset_dns
	execute_hooks "${POST_DOWN[@]}"
}

format_bytes() {
	local b=$(( ${1:-0} ))
	if   (( b >= 1073741824 )); then printf '%d GiB' "$(( b / 1073741824 ))"
	elif (( b >= 1048576    )); then printf '%d MiB' "$(( b / 1048576 ))"
	elif (( b >= 1024       )); then printf '%d KiB' "$(( b / 1024 ))"
	else                             printf '%d B'   "$b"
	fi
}

_show_flush_peer() {
	[[ -n $_p_key ]] || return 0
	echo ""
	echo "peer: $_p_key"
	[[ -n $_p_psk  ]] && echo "  preshared key: (hidden)"
	[[ -n $_p_ep   ]] && echo "  endpoint: $_p_ep"
	[[ -n $_p_aips ]] && echo "  allowed ips: $_p_aips"
	[[ -n $_p_hs   ]] && echo "  latest handshake: $_p_hs"
	[[ -n $_p_rx || -n $_p_tx ]] && \
		echo "  transfer: $(format_bytes "${_p_rx:-0}") received, $(format_bytes "${_p_tx:-0}") sent"
	[[ -n $_p_pka  ]] && echo "  persistent keepalive: every $_p_pka seconds"
	_p_key="" _p_psk="" _p_pka="" _p_ep="" _p_aips="" _p_tx="" _p_rx="" _p_hs=""
}

show_iface() {
	local iface="$1" line
	_p_key="" _p_psk="" _p_pka="" _p_ep="" _p_aips="" _p_tx="" _p_rx="" _p_hs=""

	echo "interface: $iface"
	while IFS= read -r line; do
		if   [[ $line =~ ^[[:space:]]+awgport[[:space:]]+([0-9]+) ]]; then
			echo "  listening port: ${BASH_REMATCH[1]}"
		elif [[ $line =~ ^[[:space:]]+awgpubkey[[:space:]]+([^[:space:]]+) ]]; then
			echo "  public key: ${BASH_REMATCH[1]}"
		elif [[ $line =~ ^[[:space:]]+awgversion[[:space:]]+([^[:space:]]+) ]]; then
			echo "  version: ${BASH_REMATCH[1]}"
		elif [[ $line =~ ^[[:space:]]+awgjc[[:space:]]+([0-9]+)[[:space:]]+awgjmin[[:space:]]+([0-9]+)[[:space:]]+awgjmax[[:space:]]+([0-9]+) ]]; then
			echo "  jc: ${BASH_REMATCH[1]}  jmin: ${BASH_REMATCH[2]}  jmax: ${BASH_REMATCH[3]}"
		elif [[ $line =~ ^[[:space:]]+awgs1[[:space:]]+([0-9]+)[[:space:]]+awgs2[[:space:]]+([0-9]+)([[:space:]]+awgs3[[:space:]]+([0-9]+)[[:space:]]+awgs4[[:space:]]+([0-9]+))? ]]; then
			if [[ -n ${BASH_REMATCH[3]} ]]; then
				echo "  s1: ${BASH_REMATCH[1]}  s2: ${BASH_REMATCH[2]}  s3: ${BASH_REMATCH[4]}  s4: ${BASH_REMATCH[5]}"
			else
				echo "  s1: ${BASH_REMATCH[1]}  s2: ${BASH_REMATCH[2]}"
			fi
		elif [[ $line =~ ^[[:space:]]+awgh1[[:space:]]+([0-9-]+)[[:space:]]+awgh2[[:space:]]+([0-9-]+)[[:space:]]+awgh3[[:space:]]+([0-9-]+)[[:space:]]+awgh4[[:space:]]+([0-9-]+) ]]; then
			echo "  h1: ${BASH_REMATCH[1]}  h2: ${BASH_REMATCH[2]}  h3: ${BASH_REMATCH[3]}  h4: ${BASH_REMATCH[4]}"
		elif [[ $line =~ ^[[:space:]]+awgi([1-5])[[:space:]]+(.*)$ ]]; then
			echo "  i${BASH_REMATCH[1]}: ${BASH_REMATCH[2]}"
		elif [[ $line =~ ^[[:space:]]+awghpk ]]; then
			echo "  header protection key: (hidden)"
		elif [[ $line =~ ^[[:space:]]+awgcpa[[:space:]]+([0-9-]+) ]]; then
			echo "  content padding addition: ${BASH_REMATCH[1]}"
		elif [[ $line =~ ^[[:space:]]+awg(rekeyaftertime|rekeytimeout|rejectaftertime|keepalivetimeout|maxhandshakeattempts)[[:space:]]+([0-9-]+) ]]; then
			case "${BASH_REMATCH[1]}" in
			rekeyaftertime)       echo "  rekey after time: ${BASH_REMATCH[2]}" ;;
			rekeytimeout)         echo "  rekey timeout: ${BASH_REMATCH[2]}" ;;
			rejectaftertime)      echo "  reject after time: ${BASH_REMATCH[2]}" ;;
			keepalivetimeout)     echo "  keepalive timeout: ${BASH_REMATCH[2]}" ;;
			maxhandshakeattempts) echo "  max handshake attempts: ${BASH_REMATCH[2]}" ;;
			esac
		elif [[ $line =~ ^[[:space:]]+awgrandomtrailers ]]; then
			echo "  random trailers: on"
		elif [[ $line =~ ^[[:space:]]+awgdisablecookies ]]; then
			echo "  disable cookies: on"
		elif [[ $line =~ ^[[:space:]]+awgpeer[[:space:]]+([^[:space:]]+) ]]; then
			_show_flush_peer; _p_key="${BASH_REMATCH[1]}"
		elif [[ $line =~ ^[[:space:]]+awgpsk ]]; then
			_p_psk=1
		elif [[ $line =~ ^[[:space:]]+awgpka[[:space:]]+([0-9-]+) ]]; then
			_p_pka="${BASH_REMATCH[1]}"
		elif [[ $line =~ ^[[:space:]]+awgendpoint[[:space:]]+([^[:space:]]+)[[:space:]]+([0-9]+) ]]; then
			_p_ep="${BASH_REMATCH[1]}:${BASH_REMATCH[2]}"
		elif [[ $line =~ ^[[:space:]]+'tx: '([0-9]+)', rx: '([0-9]+) ]]; then
			_p_tx="${BASH_REMATCH[1]}"; _p_rx="${BASH_REMATCH[2]}"
		elif [[ $line =~ ^[[:space:]]+'last handshake: '([0-9]+)' seconds ago' ]]; then
			_p_hs="${BASH_REMATCH[1]} seconds ago"
		elif [[ $line =~ ^[[:space:]]+awgaip[[:space:]]+([^[:space:]]+) ]]; then
			_p_aips+="${_p_aips:+, }${BASH_REMATCH[1]}"
		fi
	done < <(ifconfig "$iface" 2>/dev/null)
	_show_flush_peer
}

cmd_show() {
	local name="${1:-}" iface ifaces first=1
	if [[ -z $name ]]; then
		ifaces="$(ifconfig -a 2>/dev/null | grep -Eo '^awg[0-9]+' || true)"
		[[ -n $ifaces ]] || die "no active awg interfaces"
		while IFS= read -r iface; do
			[[ $first -eq 1 ]] || echo ""
			show_iface "$iface"
			first=0
		done <<< "$ifaces"
	else
		INTERFACE="${name%.conf}"
		get_real_interface || die "\`$name' is not an active AWG interface"
		show_iface "$REAL_INTERFACE"
	fi
}

cmd_usage() {
	cat >&2 <<-_EOF
	Usage: $PROGRAM [ up | down | show ] [ CONFIG_FILE | INTERFACE ]

	  CONFIG_FILE is a configuration file in /etc/amnezia/amneziawg/.
	  INTERFACE is the filename without .conf.

	  up | down    Bring tunnel up or down.
	  show         Show status of all active awg interfaces (or a specific one).

	  Supported [Interface] fields: PrivateKey, ListenPort, Address, MTU, DNS,
	  Table, PreUp, PostUp, PreDown, PostDown,
	  Jc, Jmin, Jmax, S1, S2, H1, H2, H3, H4,
	  Version (legacy or 3.1; default: 3.1 if any 3.1-only field is set),
	  AmneziaWG 3.1: S3, S4, H1-H4 ranges, I1-I5, HeaderProtectionKey,
	  ContentPaddingAddition, RekeyAfterTime, RekeyTimeout, RejectAfterTime,
	  KeepaliveTimeout, MaxHandshakeAttempts, RandomTrailers, DisableCookies,
	  PersistentKeepalive ranges.

	  Configures the awg(4) interface entirely via ifconfig(8).
	_EOF
}

if [[ $# -eq 1 && ( $1 == --help || $1 == -h || $1 == help ) ]]; then
	cmd_usage
elif [[ $# -eq 1 && $1 == show ]]; then
	auto_su
	cmd_show
elif [[ $# -eq 2 && $1 == show ]]; then
	auto_su
	cmd_show "$2"
elif [[ $# -eq 2 && $1 == up ]]; then
	auto_su
	parse_options "$2"
	cmd_up
elif [[ $# -eq 2 && $1 == down ]]; then
	auto_su
	parse_options "$2"
	cmd_down
else
	cmd_usage
	exit 1
fi

exit 0
