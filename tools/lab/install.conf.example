# autoinstall(8) response file for the lab VMs.
# Copy to install.conf next to the ISO and replace the password and key.
# The driver build test does not need ssh at all, but the smoke tests do.
#
# Keys must be the ones autoinstall(8) understands: "Setup a user =",
# "Password for user =", "Public ssh key for user =". An earlier version of
# this file used "User name = lab" / "Password for user lab =", which
# autoinstall ignores without an error: the install finishes with no user
# created and root ssh disabled, so the VM is unreachable over the network.

System hostname = obsd-a
Password for root = CHANGE-ME
Network interfaces = vio0
IPv4 address for vio0 = dhcp
IPv6 address for vio0 = none
Nameservers = 10.0.2.3

# The build tree lives on /home: /usr is ~4 GB and the kernel object tree plus
# the KARL relink copy do not fit next to a full source tree.
Use (W)hole disk or (E)dit the MBR = whole
Disk = sd0
Use (A)uto layout, (E)dit auto layout, or custom = auto

Set name(s)? = done
Location of sets = cd0
Server = http://10.0.2.2:8000
Set name(s)? = done
Continue without verification = yes

# A normal user with doas; root ssh with a locked password is refused.
Setup a user = lab
Password for user = CHANGE-ME
Public ssh key for user = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... lab@host
Allow root ssh login = no
