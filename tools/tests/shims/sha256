#!/usr/bin/env python3
# sha256 shim: -q <file> prints the digest, -h <db> <file> records it.
# SHA256_TABLE (tab-separated "path<TAB>digest", '*' = default) overrides the
# computed digest so a fixture can present a recorded release file's identity.
import hashlib, os, sys
a = sys.argv[1:]
path = a[-1]
table = os.environ.get("SHA256_TABLE", "")
digest = None
if table and os.path.isfile(table):
    default = None
    for line in open(table):
        parts = line.rstrip("\n").split("\t")
        if len(parts) == 2 and parts[0] == path:
            digest = parts[1]
            break
        if len(parts) == 2 and parts[0] == "*":
            default = parts[1]
    else:
        digest = default
if digest is None:
    digest = hashlib.sha256(open(path, "rb").read()).hexdigest()
if a and a[0] == "-h" and len(a) >= 3:
    # OpenBSD sha256(1): `sha256 -h hashfile file` appends
    # "SHA256 (file) = digest" to the hash file.
    with open(a[1], "a") as f:
        f.write("SHA256 (%s) = %s\n" % (path, digest))
else:
    print(digest)
