#!/usr/bin/env python3
# stat shim (BSD stat -f): answers come from STAT_TABLE, a tab-separated file
# of "path<TAB>owner<TAB>mode<TAB>size" lines; '*' is the default row.
import os, sys
path = sys.argv[-1]
fmt = sys.argv[2] if len(sys.argv) > 2 and sys.argv[1] == "-f" else "%Su"
owner, mode, size = "root", "drwxr-xr-x", "10485760"
table = os.environ.get("STAT_TABLE", "")
if table and os.path.isfile(table):
    default = None
    for line in open(table):
        parts = line.rstrip("\n").split("\t")
        if len(parts) >= 4 and parts[0] == path:
            owner, mode, size = parts[1], parts[2], parts[3]
            break
        if len(parts) >= 4 and parts[0] == "*":
            default = parts
    else:
        if default:
            owner, mode, size = default[1], default[2], default[3]
print({"%Su": owner, "%Sp": mode, "%z": size}.get(fmt, "1762600000"))
